# Copia este archivo como .env y ajusta las credenciales.
#   cp .env.example .env
# El archivo .env está en .gitignore: nunca se sube al repositorio.

# Base de datos MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventario_patrimonial
DB_USER=inventario
DB_PASS=

# Dirección y puerto del servidor de desarrollo (php -S).
# Usa la IP local para permitir pruebas desde otros equipos de la red.
APP_HOST=127.0.0.1
APP_PORT=8000
